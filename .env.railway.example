# Checklist for Railway's Variables tab; not a file to deploy with real secrets.
# Example service names: Postgres, RabbitMQ, api. References are case-sensitive.
# Railway supplies PORT. Keep all existing R2/JWT/Google/Paystack settings.
APP_PROFILE=prod
NODE_ENV=production
FRONTEND_HOST=https://your-frontend.example
ORIGIN=https://your-frontend.example

DB_TYPE=postgres
DB_HOST=${{Postgres.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=5432
DB_USERNAME=${{Postgres.POSTGRES_USER}}
DB_PASSWORD=${{Postgres.POSTGRES_PASSWORD}}
# Set Postgres.PGDATABASE to the database restored from the September 29 dump.
DB_NAME=${{Postgres.PGDATABASE}}
# Plain private-network PostGIS; change if you explicitly configure database TLS.
DB_SSL=false

# Encode username/password separately if they contain URI-reserved characters.
# Do not assume Railway references URL-encode credentials.
RABBITMQ_URI=amqp://encoded-user:encoded-password@your-broker.railway.internal:5672

# Choose resend or smtp and populate that provider's required credentials.
EMAIL_PROVIDER=resend
EMAIL_RESEND_API_KEY=replace-with-existing-secret
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_REQUIRE_TLS=true
EMAIL_SENDER=replace-with-existing-sender
ADMIN_EMAIL=replace-with-existing-comma-separated-addresses

JWT_SECRET=replace-with-existing-secret
JWT_EXPIRE=replace-with-existing-value
REFRESH_EXPIRE=replace-with-existing-value
VERIFICATION_EXPIRE=replace-with-existing-value

R2_ACCOUNT_ID=replace-with-existing-value
R2_ACCESS_KEY_ID=replace-with-existing-secret
R2_SECRET_ACCESS_KEY=replace-with-existing-secret
R2_PUBLIC_BUCKET=replace-with-existing-public-bucket
R2_PRIVATE_BUCKET=replace-with-existing-private-bucket
R2_PUBLIC_BASE_URL=https://your-existing-files-domain.example
R2_PRESIGNED_URL_TTL_SECONDS=1800

GOOGLE_CLIENT_EMAIL=replace-with-existing-value
GOOGLE_PRIVATE_KEY=replace-with-existing-secret
GOOGLE_SHEET_ID=replace-with-existing-value
GOOGLE_SHEET_NAME=replace-with-existing-value

PAYSTACK_PUBLIC_KEY=replace-with-existing-value
PAYSTACK_SECRET_KEY=replace-with-existing-secret
PAYSTACK_DOMAIN=live
PAYSTACK_TIMEOUT_MS=10000
